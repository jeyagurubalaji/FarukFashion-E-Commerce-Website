# ----- Server -----
SERVER_PORT=8080

# ----- MongoDB -----
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/faruk_fashion

# ----- JWT -----
JWT_SECRET=change-me-to-a-long-random-secret-at-least-64-bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ----- Gmail SMTP (OTP, order emails) -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=my-email@gmail.com
MAIL_PASSWORD=my-16-char-app-password

# ----- Razorpay (payments) -----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=my_razorpay_secret

# ----- Twilio (WhatsApp / SMS) – optional -----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=my_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886

# ----- App -----
FRONTEND_URL=http://localhost:3000
SELLER_EMAIL=orders@farukfashion.com
UPLOAD_DIR=uploads
SUPPORT_EMAIL=support@farukfashion.com
SUPPORT_PHONE=+91 93442 82751
ADMIN_PHONE=+91 93442 82751

